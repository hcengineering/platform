    "@hcengineering/core": "workspace:^0.7.26",
    "@hcengineering/kafka": "workspace:^0.7.20",
    "@hcengineering/platform": "workspace:^0.7.20",
    "@hcengineering/account-client": "workspace:^0.7.25",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-fileupload": "^1.5.1",
    "postgres": "^3.4.9",
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@aws-sdk/lib-storage": "^3.1107.0",
    "@smithy/node-http-handler": "^4.0.2",
    "morgan": "^1.11.0",
    "on-headers": "^1.0.2",
    "lru-cache": "^11.1.0",
    "uuid": "^11.1.1"
