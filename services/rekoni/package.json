    "docker:staging": "../../common/scripts/docker_tag.sh tracexapp/rekoni-service staging",
    "docker:push": "../../common/scripts/docker_tag.sh tracexapp/rekoni-service",
    "bundle": "node esbuild.js",
    "start": "ts-node-dev src/index.ts",
    "run-local": "cross-env ts-node src/index.ts",
    "check-ts": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests --silent",
    "format": "format src",
    "_phase:build": "compile transpile src",
    "_phase:test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests --silent",
    "_phase:format": "format src",
    "_phase:validate": "compile validate",
    "build:watch": "compile"
  },
