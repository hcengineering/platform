    "ts-jest": "^29.4.12",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-promise": "^7.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "esbuild": "^0.25.10",
