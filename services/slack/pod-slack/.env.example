# --- Slack app credentials (from https://api.slack.com/apps) ---
# Bot User OAuth Token, starts with xoxb-
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Signing secret from Basic Information -> App Credentials
SLACK_SIGNING_SECRET=your-signing-secret
# App-Level Token (Socket Mode), starts with xapp-, scope: connections:write
SLACK_APP_TOKEN=xapp-your-app-token

# Default channel id for Huly -> Slack notifications (e.g. C0123ABCD). Optional.
SLACK_DEFAULT_CHANNEL=
# Channel id where task-completion notifications are posted (e.g. C0123ABCD).
SLACK_NOTIFY_CHANNEL=

# --- Huly connection (for creating tasks) ---
# Front URL of your local Huly instance.
HULY_URL=http://huly.local:8087
# The Huly account the bot logs in as (the user you signed up with).
HULY_EMAIL=
HULY_PASSWORD=
# Workspace name from the URL: huly.local:8087/workbench/<workspace>
HULY_WORKSPACE=slackinit
ACCOUNTS_URL=http://huly.local:3000

# Service config
PORT=4025
SERVICE_ID=slack
