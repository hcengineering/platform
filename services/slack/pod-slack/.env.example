# --- Slack app OAuth credentials (api.slack.com/apps -> Basic Information) ---
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
SLACK_SIGNING_SECRET=your-signing-secret
# Any long random string; used to sign the OAuth state parameter.
SLACK_STATE_SECRET=change-me-to-a-long-random-string

# Public HTTPS base URL where this service is reachable (no trailing slash).
# Slack redirect + events URLs are derived from this.
PUBLIC_URL=https://slack.yourcompany.com

# Channel id (C...) where task notifications are posted. Optional.
SLACK_NOTIFY_CHANNEL=

# Emoji (no colons) that creates a task for a message when reacted. Default: ticket
TASK_TRIGGER_EMOJI=ticket

# Comma-separated Slack team IDs (T...) allowed to install this app.
# REQUIRED for any publicly-reachable deployment — empty means ANY Slack
# workspace can install and create tasks in your Huly workspace.
SLACK_ALLOWED_TEAMS=

# Max file size (MB) the bot downloads and attaches. Default: 25
MAX_FILE_SIZE_MB=25

# Where per-workspace Slack tokens are persisted.
INSTALL_STORE_PATH=./installations.json

# --- Huly connection (tasks are created here) ---
HULY_URL=https://huly.yourcompany.com
HULY_EMAIL=slack-bot@yourcompany.com
HULY_PASSWORD=
HULY_WORKSPACE=your-workspace-slug

PORT=4025
SERVICE_ID=slack
