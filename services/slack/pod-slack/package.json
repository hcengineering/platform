{
  "name": "@hcengineering/pod-slack",
  "version": "0.7.0",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "files": [
    "lib/**/*",
    "types/**/*",
    "tsconfig.json"
  ],
  "author": "Hardcore Engineering Inc.",
  "license": "EPL-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "run-local": "cross-env ts-node --transpile-only src/index.ts",
    "dev": "cross-env ts-node-dev --transpile-only --respawn src/index.ts",
    "test-huly": "cross-env ts-node --transpile-only src/test-huly.ts",
    "docker:build": "docker build -t hardcoreeng/slack .",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hcengineering/api-client": "^0.7.0",
    "@hcengineering/attachment": "^0.7.0",
    "@hcengineering/contact": "^0.7.0",
