    "@hcengineering/task": "^0.7.0",
    "@hcengineering/tracker": "^0.7.0",
    "@slack/bolt": "^3.22.0",
    "@slack/web-api": "^6.12.0",
    "dotenv": "^16.4.5",
    "image-size": "^1.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
